{
    "name": "e-shop-multi-vendor",
    "version": "1.0.0",
    "main": "server.js",
    "engines": {
        "node": "18.16.0"
    },
    "scripts": {
        "dev": "nodemon server.js",
        "start": "node server.js",
        "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false",
        "test": "jest --detectOpenHandles",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:report": "jest --json --outputFile=test-report.json && node scripts/generateTestReport.js",
        "test:full": "npm run test && npm run test:coverage && npm run test:report",
        "test:save": "npm run test:report && cp test-report.md ../docs/test-report-$(date +%Y%m%d%H%M%S).md"
    },
    "author": "Om Prakash Pattjoshi",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.9.0",
        "bcrypt": "^5.1.0",
        "bcryptjs": "^2.4.3",
        "chart.js": "^4.4.9",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csurf": "^1.10.0",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "helmet": "^8.0.0",
        "jest": "^29.7.0",
        "js-cookie": "^3.0.1",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^7.0.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.1",
        "nodemon": "^2.0.20",
        "razorpay": "^2.9.6",
        "react-chartjs-2": "^5.3.0",
        "redis": "^5.0.0",
        "stripe": "^12.0.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "validator": "^13.12.0"
    },
    "description": ""
}
